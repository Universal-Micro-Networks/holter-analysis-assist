# Canonical [license] section sample — owned by the license-client specification.
# Other features (http-api, packaging-distribution, etc.) MUST copy or reference
# this file only and MUST NOT redefine [license] key names or meanings.
#
# Operational security (file permissions):
#   This file holds license_key (a secret). Restrict OS permissions so only the
#   service owner can read it (example: chmod 600 on Unix / owner-only ACL on Windows).
#
# Copy to config/license.ini (or pass an explicit path) and edit values for each environment.
# Key names are identical on Windows and Linux.

[license]
# Required. License server base URL. A path prefix is allowed
# (e.g. https://host.example.com/license); a trailing "/" is added automatically.
# Endpoint paths are fixed by the server contract and cannot be changed here.
# Prefer https:// in production. http:// is allowed for local development only.
server_url=https://license.example.com

# Required. License key issued for this installation. Empty or whitespace-only is
# rejected at startup. Sent only in the "Authorization: Bearer" request header
# (never in URLs or request bodies) and never printed in logs or errors.
license_key=lk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. HTTP timeout in seconds for license requests (positive integer). Default: 10
# timeout_secs=10
