# Canonical [http] section sample — owned by the http-api specification.
# Key names and meanings below are the OWN source for HTTP listen / limits.
# Windows and Linux use the same key names.
#
# [license] is NOT redefined here. Use the upstream canonical sample:
#   config/license.ini.example
# Merge options for deployment:
#   1. Append an [http] section to a copy of license.ini (keep [license] keys unchanged), or
#   2. Keep separate files and pass each path to the HTTP / license loaders.
# The `holter-http-api` binary expects one `--config` / HOLTER_HTTP_INI file that
# contains both [http] and [license] (option 1). Default path: config/http.ini.
# Do not invent alternate license key names (server_url, api_key, etc.).
#
# TLS / transport:
#   This service listens plain HTTP (bind host:port). Terminate TLS at a reverse
#   proxy (nginx, ALB, IIS ARR, etc.) in front of bind for production HTTPS.
#
# Copy to config/http.ini (or merge into your runtime ini) and edit values.

[http]
# Required. Listen address as host:port (e.g. 0.0.0.0:8080 or 127.0.0.1:8080).
bind=0.0.0.0:8080

# Optional. Max ECL request body size in bytes. Default: 536870912 (512 MiB).
# max_body_bytes=536870912

# Optional. End-to-end max processing time per analyze request, in seconds.
# Default: 1800 (30 minutes).
# request_timeout_secs=1800

# Optional. Filesystem path to an ONNX model for non-embedded / dev builds.
# When unset and the binary is built with embedded-model, the embedded model is used.
# model_path=/path/to/phase2_rev1.onnx

# Optional. ONNX Runtime execution provider. Default: auto (cuda then cpu).
# Allowed: auto | cpu | cuda
# provider=auto

# ---------------------------------------------------------------------------
# Inference acceleration (optional; owned by the inference-acceleration spec)
# ---------------------------------------------------------------------------
# Leaving all four keys unset keeps the pre-acceleration behavior except that
# batching is 16 windows per call on models with a dynamic batch dimension
# (output CSV / JSON contract is unchanged). The CLI uses the same names and
# values as options: `_` -> `-` (e.g. --batch-size, --cuda-graph).
# Invalid values stop startup with a config error (before the license check).
# The model is loaded and warmed up with these settings before listening; see
# the "model ready provider=... batch_size=... warmup_ms=..." log line.
#
# Optional. Windows (20 s each) per inference call. Allowed: integer 1..256.
# Default: 16.
# Models with a fixed batch dimension (e.g. the current phase2_rev1.onnx,
# fixed batch 1) always use the model's batch; a different value (including
# the unset default 16) is ignored with
# "warning: model has fixed batch 1; batch_size=16 is ignored".
# Re-export with --dynamic-batch to use batching (tools/export/README.md).
# Larger values need more GPU memory.
# batch_size=16

# CUDA tuning switches. Allowed (case-insensitive): true | false | on | off | 1 | 0
# Unset = not passed to ONNX Runtime (its own default; same as before this
# feature). Applied only when the resolved provider is cuda; with cpu (or auto
# falling back to cpu) they are ignored with a "warning:" line.
#
# Optional. Allow TF32 math on Ampere or newer GPUs. Unset: ONNX Runtime default
# (TF32 enabled). Set false to compare pure FP32 math.
# cuda_tf32=false
#
# Optional. Pad Conv1D input to NC1D for cuDNN. Unset: ONNX Runtime default
# (disabled).
# cuda_conv1d_pad_to_nc1d=true
#
# Optional. Capture and replay a CUDA graph. Unset: ONNX Runtime default
# (disabled). When enabled, every call runs with the full effective batch_size
# (the last partial batch is zero-padded; padding outputs are dropped).
# With provider=auto, a CUDA graph failure found while creating the CUDA
# session falls back to cpu (stderr notice), but a capture failure during
# warm-up stops startup (message suggests cuda_graph=false); with
# provider=cuda both stop startup. Verify on the target GPU first
# (docs/perf/windows-gpu-benchmark.md) before enabling in production.
# cuda_graph=true
#
# Valid combinations:
#   - batch_size works with every provider (auto / cpu / cuda).
#   - cuda_tf32 / cuda_conv1d_pad_to_nc1d / cuda_graph take effect only with
#     provider=cuda, or provider=auto when CUDA is available. Each switch can be
#     set independently of the others.
#   - cuda_graph=true with a fixed-batch model runs at the model's batch.
# Out of scope: TensorRT, FP16 / INT8, multiple GPUs (GPU device 0 only).
# No new runtime is bundled in the distribution; install CUDA / cuDNN yourself.

# ---------------------------------------------------------------------------
# Manual smoke (NOT required in CI) — real license server + embedded binary
# ---------------------------------------------------------------------------
# When upstream license server and a `release-embedded-http-api` artifact are
# available, operators can confirm the following (fail any step → do not ship):
#
# 1. Build / download: CI job `release-embedded-http-api` yields embedded
#    `holter-http-api` (Win/Linux). No raw `.onnx` in the artifact.
# 2. Config: merge this [http] section with upstream [license] from
#    config/license.ini.example into one ini; point --config / HOLTER_HTTP_INI.
# 3. Startup: process exits non-zero and does not listen if license check fails;
#    on success, bind accepts connections.
# 4. Health: GET /health → 200 {"status":"ok"} and does not call license meter.
# 5. One analyze: POST /v1/analyze with multipart field `ecl` (valid filename)
#    → success CSV/JSON; license meter counted once per request (not per window).
#
# Automated coverage of listen / deny / meter-once / oversize uses mock license
# servers in tests/http_api_listen.rs (task 5.2). This block is operator guidance.
